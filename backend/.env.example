# Environment Configuration for SAP Datasphere Metadata & Lineage Agent

# LLM Configuration (OpenAI or OpenAI-Compatible e.g. vLLM, LMStudio, Ollama, Azure, DeepSeek)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1

# Server Configuration
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173

# Application Settings
MAX_UPLOAD_SIZE_MB=50
DEVELOPMENT_FALLBACK_MODE=true
